# Copy to .env; set unique secrets before starting. Never commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEVICE_TOKEN=
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Bind to 127.0.0.1 for laptop-only use; 0.0.0.0 allows LAN/ESP32 access.
BACKEND_BIND=0.0.0.0
FRONTEND_BIND=0.0.0.0
INSTALL_RECOGNITION=true
# Seed is opt-in; normally import roster once with: docker compose exec backend python seed.py
SEED_ROSTER=false
PAD_REAL_THRESHOLD=0.9
PAD_CROP_SCALE=2.7
# Keep false until thresholds have been measured on the target camera/data.
PAD_CALIBRATED=false
RECOGNITION_CALIBRATED=false
RECOGNITION_THRESHOLD=0.52
RECOGNITION_MARGIN=0.05
STABLE_FRAMES=3
STABLE_GAP_SECONDS=3
MIN_FACE_AREA_RATIO=0.03
MIN_SHARPNESS=25
DEVICE_OFFLINE_SECONDS=45
FRAME_INTERVAL_SECONDS=0.4
LATE_AFTER_MINUTES=15
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# SoftAP camera: laptop joins ESP32 Wi-Fi, bridge pulls /capture.
CAMERA_CAPTURE_URL=http://192.168.4.1:81/capture
CAMERA_DEVICE_ID=esp32-cam-01
CAMERA_INTERVAL_SECONDS=0.8
CAMERA_TIMEOUT_SECONDS=5
# Native Windows bridge only; Docker bridge uses http://backend:8000.
# BRIDGE_BACKEND_URL=http://127.0.0.1:8000

# Low-latency video and AI sampling are independent. Old BTL-IoT firmware uses port 81.
CAMERA_TRANSPORT=mjpeg
CAMERA_STREAM_URL=http://192.168.4.1:81/stream
CAMERA_PREVIEW_FPS=15
PREVIEW_MAX_FPS=20
